OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-5.6-luna
OPENAI_VOICE=verse
OPENAI_LANGUAGE=en
PORT=8788
ROBOT_WS_PORT=8787
# ROBOT_TRANSPORT=serial
# SERIAL_PATH=/dev/cu.usbmodem1101
SERIAL_PROTOCOL=servo
SERIAL_BAUD=115200
# Optional per-joint overrides; signs are 1 or -1 and logical limits cannot
# exceed the digital-twin limits. Physical jaw PWM must stay in 150–180
# (30° from home); looking fully down further limits that to 15°.
# SERVO_CALIBRATION_JSON={"baseYaw":{"centerDeg":90,"sign":1},"headPitch":{"centerDeg":120,"sign":1},"jawOpen":{"centerDeg":180,"sign":-1,"max":30}}
